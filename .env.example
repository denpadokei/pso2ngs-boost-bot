# Discord の Webhook URL（チャンネル設定 → 連携サービス → ウェブフック）
DISCORD_WEBHOOK_URL=

# Discord のスケジュールイベント（RSVP）も作る場合
# Bot → Reset Token で取得。CREATE_EVENTS / MANAGE_EVENTS 権限が必要
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=

# Webhook を使わず Bot で投稿する場合（DISCORD_WEBHOOK_URL が無いとき有効）
# DISCORD_CHANNEL_ID=

# 新着時にメンションするロール ID（任意）
DISCORD_MENTION_ROLE_ID=

# 投稿名・アイコン（任意）
# DISCORD_WEBHOOK_USERNAME=PSO2NGS ブースト通知
# DISCORD_WEBHOOK_AVATAR_URL=

# 通知の見た目: discal（既定）/ compact
# NOTIFY_STYLE=discal

# 状態ファイルの保存先（任意）
# STATE_PATH=data/state.json

# 検知キーワードを変えたい場合（カンマ区切り）
# BOOST_KEYWORDS=ブースト,強化応援
